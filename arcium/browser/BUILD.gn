# Browser-process services for the Arcium model: persistence, binding to live
# tabs, archiving and search. Depends on the model but not on Views.
source_set("browser") {
  sources = [
    "archive_store.cc",
    "archive_store.h",
    "arcium_profile_state.cc",
    "arcium_profile_state.h",
    "entry_claim.cc",
    "entry_claim.h",
    "model_store.cc",
    "model_store.h",
    "profile_data.cc",
    "profile_data.h",
    "profile_partition.cc",
    "profile_partition.h",
    "restored_tab_loading.cc",
    "restored_tab_loading.h",
    "session_tab_entry.cc",
    "session_tab_entry.h",
    "tab_binding.cc",
    "tab_binding.h",
    "tab_space.cc",
    "tab_space.h",
  ]
  public_deps = [
    "//arcium/browser/model",

    # session_tab_entry.h names SessionID and sessions::CommandStorageManager.
    # //components/sessions, never //chrome/browser/sessions: the session
    # command types Arcium writes and the extra_data it reads both live in
    # components, so the session hook costs this target no //chrome dep.
    "//components/sessions",
    "//components/tabs:public",
    "//sql",
    "//url",
  ]
  deps = [
    "//arcium/common",
    "//base",
    "//base:i18n",

    # BrowserContext and WebContentsUserData. No //chrome deps.
    "//content/public/browser",

    # url_constants.h, for the browser-page schemes profile_partition.cc
    # sorts into shared storage.
    "//content/public/common",

    # ContentFaviconDriver, for the favicon a restored tab asks for without
    # loading. //components, not //chrome.
    "//components/favicon/content",
  ]
}
