# The persistent sidebar model. No Chromium UI or browser dependencies, so it
# unit-tests without a browser and the playground could host it directly.
source_set("model") {
  sources = [
    "arcium_model.cc",
    "arcium_model.h",
    "arcium_model_profiles.cc",
    "arcium_profile.h",
    "entry_id.h",
    "folder.h",
    "home_boundary.cc",
    "home_boundary.h",
    "model_migration.cc",
    "model_migration.h",
    "model_serializer.cc",
    "model_serializer.h",
    "reorder_index.cc",
    "reorder_index.h",
    "space.h",
    "tab_entry.h",
  ]
  deps = [
    "//base",
    "//url",
  ]
}
