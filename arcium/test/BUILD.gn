import("//testing/test.gni")

test("arcium_unittests") {
  sources = [
    "archive_service_unittest.cc",
    "archive_store_unittest.cc",
    "arcium_features_unittest.cc",
    "arcium_model_unittest.cc",
    "arcium_profile_state_unittest.cc",
    "cold_favicon_cache_unittest.cc",
    "folder_tree_unittest.cc",
    "home_boundary_throttle_unittest.cc",
    "home_boundary_unittest.cc",
    "model_migration_unittest.cc",
    "model_serializer_unittest.cc",
    "model_store_unittest.cc",
    "reorder_index_unittest.cc",
    "session_tab_entry_unittest.cc",
    "sidebar_drag_unittest.cc",
    "sidebar_folders_unittest.cc",
    "sidebar_tab_model_unittest.cc",
    "sidebar_views_unittest.cc",
    "space_bar_unittest.cc",
    "space_gestures_unittest.cc",
    "space_scoping_unittest.cc",
    "space_selection_unittest.cc",
    "space_session_unittest.cc",
    "space_switcher_unittest.cc",
    "space_test_util.h",
    "space_wiring_unittest.cc",
    "tab_binding_unittest.cc",
    "tab_commands_unittest.cc",
    "tab_search_service_unittest.cc",
    "tab_space_unittest.cc",
    "test_app_activation.h",
  ]

  # The activation-policy override is the one thing here that has to speak to
  # AppKit: only macOS promotes an unbundled test binary to a foreground
  # application, and only NSApp can undo it. Everywhere else the no-op .cc
  # keeps the fixtures' call sites platform-free.
  if (is_mac) {
    sources += [ "test_app_activation_mac.mm" ]
    frameworks = [ "AppKit.framework" ]
  } else {
    sources += [ "test_app_activation.cc" ]
  }
  deps = [
    "//arcium/browser",
    "//arcium/browser/model",
    "//arcium/common",
    "//arcium/ui/browser",
    "//arcium/ui/playground:fake_model",
    "//arcium/ui/sidebar",
    "//base/test:test_support",
    "//chrome/browser/ui",
    "//chrome/test:test_support",
    "//chrome/test:test_support_unit",
    "//components/os_crypt/async/browser:test_support",
    "//components/segmentation_platform/public",
    "//components/sessions",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/sqlite",
    "//ui/base/dragdrop:types",
    "//ui/base/dragdrop/mojom",
    "//ui/compositor",
    "//ui/views:test_support",
  ]
}
