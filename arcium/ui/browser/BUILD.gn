# Chromium-side adapters for the Arcium sidebar. Includes chrome/browser/ui
# headers without depending on that target: //chrome/browser/ui:ui depends on
# this one and lists it in allow_circular_includes_from (patch 0010). A dep in
# both directions would be a GN dependency cycle.
source_set("browser") {
  sources = [
    "browser_sidebar_controller.cc",
    "browser_sidebar_controller.h",
    "color_ids_check.cc",
    "quick_entry_bubble.cc",
    "quick_entry_bubble.h",
    "sidebar_tab_model.cc",
    "sidebar_tab_model.h",
  ]
  deps = [
    "//arcium/common",
    "//arcium/ui/sidebar",
    "//base",
    "//chrome/app:command_ids",
    "//chrome/browser/ui/color:color_headers",
    "//components/omnibox/browser",
    "//components/tabs:public",
    "//content/public/browser",
    "//third_party/metrics_proto",
    "//ui/views",
  ]
}
