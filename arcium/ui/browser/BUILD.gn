# Chromium-side adapters for the Arcium sidebar. Includes chrome/browser/ui
# headers without depending on that target: //chrome/browser/ui:ui depends on
# this one and lists it in allow_circular_includes_from (patch 0010). A dep in
# both directions would be a GN dependency cycle.
source_set("browser") {
  sources = [
    "archive_service.cc",
    "archive_service.h",
    "box_commands.cc",
    "box_commands.h",
    "browser_sidebar_controller.cc",
    "browser_sidebar_controller.h",
    "browser_sidebar_controller_box.cc",
    "clear_data_warning.cc",
    "clear_data_warning.h",
    "cold_favicon_cache.cc",
    "cold_favicon_cache.h",
    "color_ids_check.cc",
    "command_box.cc",
    "command_box.h",
    "command_box_row.cc",
    "command_box_row.h",
    "home_boundary_throttle.cc",
    "home_boundary_throttle.h",
    "hosted_location_bar.cc",
    "hosted_location_bar.h",
    "last_sidebar_window.cc",
    "last_sidebar_window.h",
    "new_tab_storage.cc",
    "new_tab_storage.h",
    "outside_link_window.cc",
    "outside_link_window.h",
    "outside_links.cc",
    "outside_links.h",
    "page_in_space.cc",
    "page_in_space.h",
    "partition_guard_throttle.cc",
    "partition_guard_throttle.h",
    "peek_controller.cc",
    "peek_controller.h",
    "peek_view.cc",
    "peek_view.h",
    "profile_actions.cc",
    "profile_actions.h",
    "profile_reopen.cc",
    "profile_reopen.h",
    "second_launch.cc",
    "second_launch.h",
    "session_rebuild_nudge.cc",
    "session_rebuild_nudge.h",
    "sidebar_tab_model.cc",
    "sidebar_tab_model.h",
    "sidebar_tab_model_entries.cc",
    "sidebar_tab_model_profiles.cc",
    "sidebar_tab_model_spaces.cc",
    "space_switcher.cc",
    "space_switcher.h",
    "space_switcher_spaces.cc",
    "suggestion_source.cc",
    "suggestion_source.h",
    "tab_close_types.h",
    "tab_commands.cc",
    "tab_commands.h",
    "tab_search_service.cc",
    "tab_search_service.h",
    "tab_selection.cc",
    "tab_selection.h",
  ]

  # Public: this target's own headers include tab_binding.h, archive_store.h
  # and arcium_model.h, so anything that includes them needs //arcium/browser
  # too. //chrome/browser/ui:ui is such a target twice over — browser_view.cc
  # through browser_sidebar_controller.h, and browser_tabrestore.cc directly,
  # for patch 0120's hook.
  public_deps = [
    "//arcium/browser",
    "//arcium/browser/model",
  ]

  # FaviconServiceFactory is included the same way the chrome/browser/ui
  # headers above are: through the circular-includes allowance, not through a
  # dep. Depending on //chrome/browser/favicon drags in the profile and
  # history graphs and is the dependency direction patch 0010 exists to avoid.
  deps = [
    "//arcium/common",
    "//arcium/ui/sidebar",
    "//base",
    "//base:i18n",
    "//chrome/app:command_ids",

    # SessionServiceFactory, for the rebuild nudge. This target is reachable
    # from //chrome/browser/ui:ui but does not reach back to it, so the dep
    # is not part of that cycle.
    "//chrome/browser/sessions",
    "//chrome/browser/ui/color:color_headers",

    # SecurityStateTabHelper, which is what decides whether the pill wears a
    # warning. //chrome/browser/ui/page_info is reached the same way the
    # chrome/browser/ui headers above are, through the circular-includes
    # allowance rather than a dep.
    "//components/security_state/content",

    # prefs::kShouldGarbageCollectStoragePartitions, which a profile's
    # deletion sets when its partition is still in use.
    "//chrome/common:constants",

    # TimePeriod and its begin and end times, for the clear-data warning.
    "//components/browsing_data/core",

    # ShowWebModal, for the clear-data warning over the settings page.
    "//components/constrained_window",
    "//components/favicon/core",
    "//components/favicon_base",
    "//components/keyed_service/core",
    "//components/omnibox/browser",
    "//components/search_engines",
    "//components/tabs:public",
    "//components/vector_icons",
    "//content/public/browser",
    "//third_party/metrics_proto",

    # display::Screen, for placing the outside-link window on the screen the
    # browser window is on.
    "//ui/display",
    "//ui/views",

    # views::WebView, for the page inside a peek and an outside link's window.
    "//ui/views/controls/webview",
  ]
}
