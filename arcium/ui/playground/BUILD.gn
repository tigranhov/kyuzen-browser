# The in-memory SidebarModel the playground runs on. A separate target so the
# view tests can drive the same fake the playground does, rather than a second
# one that could drift from it.
source_set("fake_model") {
  testonly = true
  sources = [
    "fake_sidebar_model.cc",
    "fake_sidebar_model.h",
    "fake_sidebar_profiles.cc",
    "fake_sidebar_spaces.cc",
  ]
  public_deps = [
    "//arcium/ui/sidebar",
    "//base",
  ]
  deps = [
    "//cc/paint",
    "//skia",
    "//ui/base",
    "//ui/gfx",
  ]
}

# The in-memory WelcomeModel the playground's welcome runs on, shared with the
# welcome view tests for the same reason as the sidebar's fake.
source_set("fake_welcome") {
  testonly = true
  sources = [
    "fake_welcome_model.cc",
    "fake_welcome_model.h",
  ]
  public_deps = [
    "//arcium/ui/welcome",
    "//base",
  ]
}

# Standalone Views host for Arcium's sidebar components. No //chrome deps.
executable("arcium_playground") {
  testonly = true
  sources = [
    "arcium_playground_main.cc",
    "sidebar_example.cc",
    "sidebar_example.h",
    "snapshot.cc",
    "snapshot.h",
    "welcome_example.cc",
    "welcome_example.h",
  ]
  deps = [
    ":fake_model",
    ":fake_welcome",
    "//arcium/ui/sidebar",
    "//base",
    "//base/test:test_support",
    "//cc/paint",
    "//components/viz/common",
    "//skia",
    "//ui/base",
    "//ui/color",
    "//ui/compositor",
    "//ui/gfx",
    "//ui/views",
    "//ui/views/examples:views_examples_lib",
    "//ui/views/examples:views_examples_proc",
  ]

  # ExamplesMainProc loads ui_test.pak and views_examples_resources.pak from
  # the output directory.
  data_deps = [
    "//ui/resources:ui_test_pak",
    "//ui/views/examples:views_examples_resources_pak",
  ]
}
