import("//components/vector_icons/vector_icons.gni")

aggregate_vector_icons("sidebar_icons") {
  icon_directory = "icons"
  sources = [
    "add.icon",
    "audio.icon",
    "back.icon",
    "close.icon",
    "disclosure_collapsed.icon",
    "disclosure_expanded.icon",
    "forward.icon",
    "muted.icon",
    "reload.icon",
    "revert.icon",
    "sidebar.icon",
  ]
}

# Pure Views. Must not depend on //chrome/browser so the playground stays small.
source_set("sidebar") {
  sources = [
    "archive_list_view.cc",
    "archive_list_view.h",
    "favorites_grid_view.cc",
    "favorites_grid_view.h",
    "folder_header_view.cc",
    "folder_header_view.h",
    "nav_row_view.cc",
    "nav_row_view.h",
    "rename_field.cc",
    "rename_field.h",
    "row_context_menu.cc",
    "row_context_menu.h",
    "row_drag_data.cc",
    "row_drag_data.h",
    "row_drag_image.cc",
    "row_drag_image.h",
    "row_drag_session.cc",
    "row_drag_session.h",
    "section_divider_view.cc",
    "section_divider_view.h",
    "sidebar_colors.cc",
    "sidebar_colors.h",
    "sidebar_metrics.h",
    "sidebar_model.h",
    "sidebar_view.cc",
    "sidebar_view.h",
    "space_bar_view.cc",
    "space_bar_view.h",
    "tab_list_view.cc",
    "tab_list_view.h",
    "tab_row_view.cc",
    "tab_row_view.h",
    "tint_background.cc",
    "tint_background.h",
    "url_pill_view.cc",
    "url_pill_view.h",
    "view_snapshot.cc",
    "view_snapshot.h",
  ]
  sources += get_target_outputs(":sidebar_icons")
  public_deps = [
    # sidebar_model.h names EntryId and FolderId, so every consumer of this
    # header needs the model target. It carries no Chromium UI or browser
    # dependency, so the playground stays small.
    "//arcium/browser/model",
    "//base",
    "//ui/base",
    "//ui/color",
    "//ui/views",
    "//url",
  ]
  deps = [
    ":sidebar_icons",
    "//cc/paint",
    "//components/vector_icons",
    "//skia",
    "//ui/base/dragdrop:types",
    "//ui/base/dragdrop/mojom",
    "//ui/compositor",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//ui/menus",
  ]
}
