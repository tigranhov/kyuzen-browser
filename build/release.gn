# Shipping build (Stage 8). Official build enables LTO and other optimisations; no PGO profile download.
is_debug = false
is_official_build = true
chrome_pgo_phase = 0
is_component_build = false
dcheck_always_on = false
symbol_level = 1
blink_symbol_level = 0
v8_symbol_level = 0
enable_dsyms = true
enable_stripping = true

# An official build turns on link-time optimisation, which only lld can do,
# and lld cannot link against the Xcode 27 SDK on this machine: its stub
# libraries name targets (arm64e.x1-macos) that the bundled lld does not
# understand, so every link fails before it starts. That is why the shared
# config chooses Apple's own linker, and it is why a shipping build here goes
# without LTO. Revisit when the checkout's toolchain catches up with the SDK.
use_thin_lto = false
