Seam: BrowserViewLayoutDelegateImpl::GetBrowserLayoutParams, IsToolbarVisible,
      IsBookmarkBarVisible.
Why: reserve the sidebar column from the visual client area; hide the toolbar
     and the bookmark bar. Arcium has a place for neither, and a bookmark bar
     left visible by a profile preference shows as a stray top panel whose
     only content is the saved-tab-group button.
Delegates to: BrowserSidebarController::AdjustLayoutParams

diff --git a/chrome/browser/ui/views/frame/layout/browser_view_layout_delegate_impl.cc b/chrome/browser/ui/views/frame/layout/browser_view_layout_delegate_impl.cc
index 6a49065d92..2a706580c1 100644
--- a/chrome/browser/ui/views/frame/layout/browser_view_layout_delegate_impl.cc
+++ b/chrome/browser/ui/views/frame/layout/browser_view_layout_delegate_impl.cc
@@ -87,8 +87,12 @@ BrowserLayoutParams BrowserViewLayoutDelegateImpl::GetBrowserLayoutParams(
       use_browser_bounds = false;
     }
 #endif
-    return params.InLocalCoordinates(
+    BrowserLayoutParams result = params.InLocalCoordinates(
         use_browser_bounds ? browser_bounds : params.visual_client_area);
+    if (auto* sidebar = browser_view_->arcium_sidebar()) {
+      sidebar->AdjustLayoutParams(result);
+    }
+    return result;
   }
 
   return BrowserLayoutParams();
@@ -118,10 +122,16 @@ views::LayoutAlignment BrowserViewLayoutDelegateImpl::GetWindowTitleAlignment()
 }
 
 bool BrowserViewLayoutDelegateImpl::IsToolbarVisible() const {
+  if (browser_view_->arcium_sidebar()) {
+    return false;
+  }
   return browser_view_->IsToolbarVisible();
 }
 
 bool BrowserViewLayoutDelegateImpl::IsBookmarkBarVisible() const {
+  if (browser_view_->arcium_sidebar()) {
+    return false;
+  }
   return browser_view_->IsBookmarkBarVisible();
 }
 
