     ":navigator",
+
+    # Arcium: browser_navigator.cc calls arcium/ui/browser/new_tab_storage.h.
+    "//arcium/ui/browser",
     "//base",
     "//chrome/browser:browser_about_handler",
     "//chrome/browser:browser_public_dependencies",
