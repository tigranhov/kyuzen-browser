+  // page.
+  std::vector<GURL> arciumUrls;
+  for (NSURL* url in urls) {
+    arciumUrls.push_back(net::GURLWithNSURL(url));
+  }
+  if (arcium::OpenOutsideLinks(arciumUrls)) {
+    return;
+  }
