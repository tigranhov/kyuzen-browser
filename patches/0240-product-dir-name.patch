Seam: chrome/app/app-Info.plist, the outer application's property list, and
      the tweak_info_plist("chrome_app_plist") target in chrome/BUILD.gn that
      stamps the version keys into it.
Why: two things the application has to say about itself and could not.

     The folder under ~/Library/Application Support that holds a profile is
     named by the CrProductDirName key in the outer bundle, and with the key
     absent an unbranded build falls back to the literal name "Chromium" --
     so this browser stored everything a reader does in a folder any other
     Chromium build on the machine reads and writes too. Chromium writes the
     key during packaging rather than at build time, which is no help to a
     build that is run straight out of the output directory, and it is a
     branding fact rather than a packaging one.

     The bundle's version keys came from Chromium's version, so two releases
     of this browser carrying the same Chromium were indistinguishable --
     including to an update deciding whether it has anything newer to offer.
     They now come from KYUZEN_VERSION, through the overrides the stamping
     script already accepts, with the build number placed where the bundle
     version reads it so that it always increases.

     Taken here because this is the only file those keys can live in: the
     code reads them from the outer application, and the values come from
     the same branding and version files everything else reads.
Delegates to: nothing. This patch carries no call -- it is branding and
     version values substituted by GN, of the same kind as the bundle
     identifier beside them.

diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index a33fe738ba..6f105f072d 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -3,6 +3,7 @@
 # found in the LICENSE file.
 
 import("//build/config/chrome_build.gni")
+import("//arcium/kyuzen_version.gni")
 import("//build/config/chromeos/args.gni")
 import("//build/config/compiler/compiler.gni")
 import("//build/config/compiler/pgo/pgo.gni")
@@ -508,6 +509,9 @@ if (is_win) {
       "--scm=1",
       "--bundle_id=$chrome_mac_bundle_id",
     ]
+    foreach(_override, kyuzen_version_overrides) {
+      args += [ "--version-overrides=$_override" ]
+    }
     if (enable_updater) {
       args += [ "--privileged_helper_id=$privileged_helper_name" ]
       if (is_chrome_branded) {
diff --git a/chrome/app/app-Info.plist b/chrome/app/app-Info.plist
index 6fada0a2b1..9422e3b563 100644
--- a/chrome/app/app-Info.plist
+++ b/chrome/app/app-Info.plist
@@ -161,6 +161,8 @@
 	<string>APPL</string>
 	<key>CFBundleSignature</key>
 	<string>${CHROMIUM_CREATOR}</string>
+	<key>CrProductDirName</key>
+	<string>${CHROMIUM_SHORT_NAME}</string>
 	<key>NSAppleScriptEnabled</key>
 	<true/>
 	<key>OSAScriptingDefinition</key>
