+++ b/chrome/browser/ui/webui/settings/settings_localized_strings_provider.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/ui/webui/settings/settings_localized_strings_provider.h"
 
+#include "arcium/common/product_version.h"
+
 #include <string>
 
 #include "base/command_line.h"
@@ -339,7 +341,7 @@ void AddAboutStrings(content::WebUIDataSource* html_source, Profile* profile) {
       l10n_util::GetStringUTF16(IDS_SETTINGS_UPGRADE_UP_TO_DATE));
 #endif
 
-  std::u16string browser_version = VersionUI::GetAnnotatedVersionStringForUi();
+  std::u16string browser_version = arcium::AboutVersionText();
 
   html_source->AddString("aboutBrowserVersion", browser_version);
   html_source->AddString(
