#!/usr/bin/env bash
# Build the development build's application icon from the real one, by
# draining the colour out of it. A development build and a release sit in the
# Dock beside each other and were impossible to tell apart; a grey Kyuzen is
# the one that came out of out/dev.
#
# Run this after changing the real icon. It writes
# arcium/branding/theme/mac/dev/, which is committed, so an ordinary build
# needs neither Xcode's asset tools nor this script.
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

THEME="$ARCIUM_ROOT/arcium/branding/theme/mac"
DEV="$THEME/dev"
GRAY="/System/Library/ColorSync/Profiles/Generic Gray Gamma 2.2 Profile.icc"

command -v actool >/dev/null || die "actool is missing; install Xcode's command line tools"
[ -f "$GRAY" ] || die "no grey colour profile at $GRAY"

rm -rf "$DEV"
mkdir -p "$DEV/Assets.xcassets/AppIcon.appiconset" "$DEV/iconset"

cp "$THEME/Assets.xcassets/Contents.json" "$DEV/Assets.xcassets/Contents.json"
cp "$THEME/Assets.xcassets/AppIcon.appiconset/Contents.json" \
   "$DEV/Assets.xcassets/AppIcon.appiconset/Contents.json"

drain() {  # drain <in.png> <out.png>
  sips -m "$GRAY" "$1" --out "$2" >/dev/null
}

for png in "$THEME"/Assets.xcassets/AppIcon.appiconset/*.png; do
  drain "$png" "$DEV/Assets.xcassets/AppIcon.appiconset/$(basename "$png")"
done

# The .icns the Dock falls back to, built from the two largest images.
drain "$THEME/Assets.xcassets/AppIcon.appiconset/appicon_512.png" \
      "$DEV/iconset/icon_512x512.png"
drain "$THEME/Assets.xcassets/AppIcon.appiconset/appicon_1024.png" \
      "$DEV/iconset/icon_512x512@2x.png"
drain "$THEME/Assets.xcassets/AppIcon.appiconset/appicon_256.png" \
      "$DEV/iconset/icon_256x256.png"
drain "$THEME/Assets.xcassets/AppIcon.appiconset/appicon_512.png" \
      "$DEV/iconset/icon_256x256@2x.png"
drain "$THEME/Assets.xcassets/AppIcon.appiconset/appicon_128.png" \
      "$DEV/iconset/icon_128x128.png"
drain "$THEME/Assets.xcassets/AppIcon.appiconset/appicon_256.png" \
      "$DEV/iconset/icon_128x128@2x.png"
drain "$THEME/Assets.xcassets/AppIcon.appiconset/appicon_32.png" \
      "$DEV/iconset/icon_32x32.png"
drain "$THEME/Assets.xcassets/AppIcon.appiconset/appicon_64.png" \
      "$DEV/iconset/icon_32x32@2x.png"
drain "$THEME/Assets.xcassets/AppIcon.appiconset/appicon_16.png" \
      "$DEV/iconset/icon_16x16.png"
drain "$THEME/Assets.xcassets/AppIcon.appiconset/appicon_32.png" \
      "$DEV/iconset/icon_16x16@2x.png"
mv "$DEV/iconset" "$DEV/icon.iconset"
iconutil --convert icns --output "$DEV/app.icns" "$DEV/icon.iconset"
rm -rf "$DEV/icon.iconset"

# The catalogue macOS actually reads on a recent system.
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
actool --compile "$TMP" --platform macosx --minimum-deployment-target 13.0 \
  --app-icon AppIcon --output-partial-info-plist "$TMP/partial.plist" \
  --notices --warnings "$DEV/Assets.xcassets" >/dev/null
[ -f "$TMP/Assets.car" ] || die "actool wrote no Assets.car"
cp "$TMP/Assets.car" "$DEV/Assets.car"
rm -rf "$DEV/Assets.xcassets"

log "wrote $DEV/app.icns and $DEV/Assets.car"
