#!/usr/bin/env bash
# Build and launch arcium_playground, the standalone Views host for Arcium's sidebar
# components, for fast UI iteration. Pass --enable-examples=NAME to open one example directly.
source "$(dirname "$0")/lib.sh"
need_src
config="${ARCIUM_CONFIG:-dev}"
"$ARCIUM_ROOT/scripts/build" "$config" arcium_playground
bin="$SRC/out/$config/arcium_playground"
[ -x "$bin" ] || die "arcium_playground did not produce $bin"
exec "$bin" "$@"
